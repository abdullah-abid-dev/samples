\par \pard\plain \s0\nowidctlpar\hyphpar0\ltrpar\kerning1\cf0\rtlch\af6\afs24\alang1081\ltrch\hich\af3\afs24\alang1033\dbch\af8\langfe2052\loch\f3\fs24\lang1033\ql\ltrpar{\b
Stephen Laine}{
 [00:22:18\u8211\'9600:22:41]\line Back in the routine, everything's good. Yeah, I mean, he's, he's going to a life skills school and he's doing okay there. Nothing's wrong going on. And so I, um, so then I get a phone call from his life skills school that, uh, hey, he's trying to access, he's trying to run, he's trying to go in different areas, and he just tried going into an Amazon truck.}
\par \pard\plain \s0\nowidctlpar\hyphpar0\ltrpar\kerning1\cf0\rtlch\af6\afs24\alang1081\ltrch\hich\af3\afs24\alang1033\dbch\af8\langfe2052\loch\f3\fs24\lang1033\ql\ltrpar{\b
